# 서버 ops/.env 견본(실제 .env는 서버에만, chmod 600, 커밋 금지).
# 값은 서버에서 생성한다:  python3 -c "import secrets; print(secrets.token_urlsafe(50))"
DEBUG=0
SECRET_KEY=서버에서-생성
SITE_URL=https://t.goteacher.xyz
# localhost는 컨테이너 healthcheck(/healthz)용
ALLOWED_HOSTS=localhost
POSTGRES_PASSWORD=서버에서-생성
# 비밀번호는 URL에 그대로 들어가므로 영숫자로 만든다(secrets.token_hex).
DATABASE_URL=postgres://goteacher:POSTGRES_PASSWORD와-같은-값@db:5432/goteacher
REDIS_URL=redis://redis:6379/0
