# 복사해서 저장소 루트 .env로 쓴다(.env는 커밋 금지). 아래 값은 로컬 개발용.
DEBUG=1
SECRET_KEY=change-me-local-only
SITE_URL=http://localhost:8000
# 쉼표로 추가 호스트. SITE_URL 호스트는 자동 포함.
ALLOWED_HOSTS=
# 주석이면 app/db.sqlite3. 운영 예: postgres://goteacher:비밀번호@db:5432/goteacher
# DATABASE_URL=
# 구글 OAuth(웹 클라이언트). 값은 ~/.config/troad/google_oauth_client.json에서. 리디렉션은 SITE_URL + /auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# 웹 푸시(G2). 비우면 '이 PC에서 알림 받기'를 숨긴다. 로컬 확인용 키는 ops/README.md 방법으로 만들고 끝나면 지운다
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@goteacher.xyz
